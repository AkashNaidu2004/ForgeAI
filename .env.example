# copy to .env (never commit .env)
FORGE_PROVIDER=openai
FORGE_BASE_URL=https://api.groq.com/openai/v1
FORGE_API_KEY=your_groq_key_here
FORGE_MODEL=your-generator-model-id
FORGE_JUDGE_MODEL=your-judge-model-id
# Ollama fallback instead:
# FORGE_PROVIDER=ollama
# FORGE_MODEL=qwen2.5:7b
# FORGE_JUDGE_MODEL=llama3.2:3b

# --- API budget (set to YOUR provider's limits page; defaults are the Groq free-tier values you reported) ---
FORGE_RPM=30
FORGE_TPM=8000
FORGE_RPD=1000
FORGE_TPD=200000
FORGE_LIMIT_MARGIN=0.85
# tokens assumed for the reply when pacing (real counts replace this after each call)
FORGE_COMPLETION_RESERVE=800
# response cache (resume interrupted runs for free); 0 disables
FORGE_CACHE=1
# Local fallback when the hosted DAILY budget is gone (needs `ollama serve` running and the models pulled):
# FORGE_FALLBACK=ollama
# FORGE_FALLBACK_MODEL=qwen2.5:7b
# FORGE_FALLBACK_JUDGE_MODEL=llama3.2:3b
